# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.
#
# NEXT_PUBLIC_* values are visible in the browser. Only put public info there.
# Anything without that prefix stays on the server.

# Public URL of the site (no trailing slash). Used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
