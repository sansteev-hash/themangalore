# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.
#
# NEXT_PUBLIC_* values are visible in the browser. Only put public info there.
# Anything without that prefix stays on the server.
#
# On Vercel, add the same variables under:
#   Project → Settings → Environment Variables

# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the site (no trailing slash). Used for SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Forms ───────────────────────────────────────────────────────────────
# Master switch for the contact form and product waitlist. Only set to
# "true" once Supabase below is configured, so no messages are lost.
FORMS_ENABLED=false

# ── Supabase (stores enquiries and waitlist signups) ────────────────────
# Supabase dashboard → Project Settings → API (or "API Keys").
SUPABASE_URL=https://your-project-ref.supabase.co
# SECRET key (starts with sb_secret_…, or the legacy "service_role" key).
# Server-only. Never put it in a NEXT_PUBLIC_ variable or share it.
SUPABASE_SECRET_KEY=

# ── Email alerts via Resend (optional but recommended) ──────────────────
# resend.com → API Keys. Secret — server-only.
RESEND_API_KEY=
# Where new-enquiry alerts are sent.
LEAD_ALERT_TO=you@example.com
# Sender. Until your domain is verified in Resend, leave this unset to use
# "onboarding@resend.dev" (which can only email your Resend account address).
# LEAD_ALERT_FROM=TheMangalore.in <alerts@themangalore.in>
